{
  "name": "tournament-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run licenses && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "licenses": "node ./scripts/collect-licenses.ts",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint \"src/**/*.{js,ts,astro}\"",
    "lint:fix": "prettier --check . && eslint \"src/**/*.{js,ts,astro}\" --fix",
    "check": "astro sync && astro check --tsconfig ./tsconfig.json && tsc -p ./worker/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.3.2",
    "sass": "^1.104.0",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@eslint/js": "^9.39.5",
    "@quantco/pnpm-licenses": "2.4.2",
    "@sveltejs/kit": "^2.70.3",
    "@types/node": "^25.9.5",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "wrangler": "^4.130.0"
  },
  "packageManager": "pnpm@11.13.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.1",
      "onFail": "download"
    }
  }
}
