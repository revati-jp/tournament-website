{
  "name": "tournament-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run licenses && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "licenses": "node ./scripts/collect-licenses.ts",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint \"src/**/*.{js,ts,astro}\"",
    "lint:fix": "prettier --check . && eslint \"src/**/*.{js,ts,astro}\" --fix",
    "check": "astro sync && astro check --tsconfig ./tsconfig.json && tsc -p ./worker/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/svelte": "^8.1.2",
    "astro": "^6.4.8",
    "sass": "^1.101.0",
    "sharp": "^0.35.2",
    "svelte": "^5.56.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20260619.1",
    "@eslint/js": "^9.39.4",
    "@quantco/pnpm-licenses": "2.4.2",
    "@sveltejs/kit": "^2.66.0",
    "@types/node": "^25.9.4",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "wrangler": "^4.103.0"
  },
  "packageManager": "pnpm@10.32.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.32.1",
      "onFail": "error"
    }
  }
}
