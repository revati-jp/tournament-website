---
import type { CastData } from "@app-types/community/gateway";
import { Image } from "astro:assets";
import CastCard, { DESKTOP_CARD_WIDTH } from "./CastCard.astro";

import koreniteItomaDesktop01 from "@assets/community/gateway/cast/desktop_01_korenite_itoma.webp";
import gappo3Desktop02 from "@assets/community/gateway/cast/desktop_02_gappo3.webp";
import kayDesktop03 from "@assets/community/gateway/cast/desktop_03_kay.webp";
import koreniteItomaMobile01 from "@assets/community/gateway/cast/mobile_01_korenite_itoma.webp";
import gappo3Mobile02 from "@assets/community/gateway/cast/mobile_02_gappo3.webp";
import kayMobile03 from "@assets/community/gateway/cast/mobile_03_kay.webp";
import day04 from "@assets/community/gateway/cast/desktop_04_day.webp";

const CASTS: CastData[] = [
  {
    altText:
      "DAY1で実況を担当する是以いとまのプロフィール。Lazuli所属のクリエイター、OWCS JAPAN初の女性公式キャスター。大会実況を担当しながらストリーマーとしても活動しており、「熱血系ギャル」として明るい声色やトークで人気を集める。",
    desktopImage: koreniteItomaDesktop01,
    mobileImage: koreniteItomaMobile01,
    days: "DAY1",
    socials: {
      twitch: "https://www.twitch.tv/kn_itoma",
      twitter: "https://x.com/koretoma_",
    },
  },
  {
    altText:
      "DAY1とDAY2で解説を担当するgappo3のプロフィール。Overwatch黎明期に、日本最高峰のチーム「Green Leaves」の選手として活動したのち、公式解説としてデビュー。Overwatchワールドカップでも公式キャスターに選出されており、どんなプレイも見逃さず、ハイレベルな解説を提供する。",
    desktopImage: gappo3Desktop02,
    mobileImage: gappo3Mobile02,
    days: "DAY1 / DAY2",
    socials: {
      twitch: "https://www.twitch.tv/gappo3",
      twitter: "https://x.com/gappo3gappo3",
    },
  },
  {
    altText:
      "DAY2で実況を担当するKayのプロフィール。99DIVINEの運営スタッフでもあり、前回大会「REVATI Challengers CUP」を始め、多くのコミュニティ大会で実況を務める。Overwatchコミュニティで名が知れており、まさに「安心安全」の実況をお届け。",
    desktopImage: kayDesktop03,
    mobileImage: kayMobile03,
    days: "DAY2",
    socials: {
      twitter: "https://x.com/Kaynora43",
    },
  },
];
---

<div class="cast-container">
  <div class="desktop">
    <div class="desktop-cards">
      {CASTS.map((cast) => <CastCard cast={cast} image={cast.desktopImage} />)}
    </div>
    <div class="day-banner">
      {
        /* `display: none` で読まれなくなるため、この画像のための代替テキストは各プロフィールに分散して記載。 */
      }
      <Image src={day04} alt="" class="day-image" />
    </div>
  </div>
  <div class="mobile">
    {
      CASTS.map((cast) => (
        <CastCard cast={cast} image={cast.mobileImage} isMobile />
      ))
    }
  </div>
</div>

<style lang="scss" define:vars={{ "card-width": DESKTOP_CARD_WIDTH }}>
  $cast-layout-switch-breakpoint: 1080px;
  $card-gap: 0.6rem;

  .cast-container {
    .desktop {
      margin-inline: auto;
      display: flex;
      align-items: center;
      flex-direction: column;

      .desktop-cards {
        display: grid;
        grid-template-columns: repeat(3, max-content);
        gap: $card-gap;
        align-items: start;
      }

      .day-banner {
        width: calc(3 * var(--card-width) + 2 * $card-gap - 4px);
        margin-top: -0.5rem;

        .day-image {
          width: 100%;
          height: auto;
          max-width: none;
          display: block;
        }
      }
    }

    .mobile {
      display: none;
      grid-template-columns: max-content;
      justify-content: center;
    }

    @media screen and (max-width: $cast-layout-switch-breakpoint) {
      .desktop {
        display: none;
      }

      .mobile {
        display: grid;
      }
    }
  }
</style>
