---
import { Image } from "astro:assets";
import type { CardItem } from "@app-types/community/gateway";
import IconButton from "./IconButton.astro";

import TwitchIcon from "@components/icons/TwitchIcon.astro";
import TwitterXIcon from "@components/icons/TwitterXIcon.astro";
import InstagramIcon from "@components/icons/InstagramIcon.astro";
import LineIcon from "@components/icons/LineIcon.astro";
import Button from "./Button.astro";
import BoxArrowUpRightIcon from "@components/icons/BoxArrowUpRightIcon.astro";
import YouTubeIcon from '@components/icons/YouTubeIcon.astro';

interface Props {
  item: CardItem;
}

const { item } = Astro.props;
---

<div class="card">
  <div class="logo">
    {
      typeof item.logoImage === "string" ? (
        <img src={item.logoImage} alt={item.name} />
      ) : (
        <Image src={item.logoImage} alt={item.name} />
      )
    }
  </div>
  <div class="body">
    <div class="info">
      <p class="name">{item.name}</p>
      <p class="description">{item.description}</p>
    </div>
    <div class="links">
      {
        item.website && (
          <div class="website">
            <Button href={item.website} target="_blank">
              公式サイト <BoxArrowUpRightIcon />
            </Button>
          </div>
        )
      }
      <div class="socials">
        {
          item.socials.youtube && (
            <div class="social-youtube">
              <IconButton href={item.socials.youtube} target="_blank">
                <YouTubeIcon size={24} />
              </IconButton>
            </div>
          )
        }
        {
          item.socials.twitch && (
            <div class="social-twitch">
              <IconButton href={item.socials.twitch} target="_blank">
                <TwitchIcon size={24} />
              </IconButton>
            </div>
          )
        }
        {
          item.socials.twitter && (
            <div class="social-x">
              <IconButton href={item.socials.twitter} target="_blank">
                <TwitterXIcon size={24} />
              </IconButton>
            </div>
          )
        }
        {
          item.socials.instagram && (
            <div class="social-instagram">
              <IconButton href={item.socials.instagram} target="_blank">
                <InstagramIcon size={24} />
              </IconButton>
            </div>
          )
        }
        {
          item.socials.line && (
            <div class="social-line">
              <IconButton href={item.socials.line} target="_blank">
                <LineIcon size={24} />
              </IconButton>
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  // 要素横幅670pxあたりが限界
  .card {
    width: 100%;
    max-width: 900px;
    display: flex;
    border: 2px solid rgba(commGateway.$color-text, 0.2);
    border-radius: 6px;

    @include sp {
      flex-direction: column;
    }

    .logo {
      width: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.6rem;
      border-right: 2px solid rgba(commGateway.$color-text, 0.2);

      img {
        max-width: 100%;
        max-height: 260px;
        object-fit: contain;
      }

      // 上側
      @include sp {
        width: auto;
        padding-inline: 4rem;
        border-right: none;
        border-bottom: 2px solid rgba(commGateway.$color-text, 0.2);
      }
    }

    .body {
      width: 50%;
      padding: 1.6rem;
      display: flex;
      flex-direction: column;

      @include sp {
        width: auto;
      }

      .info {
        flex-grow: 1;
        padding: 0 0.4rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(commGateway.$color-text, 0.2);

        .name {
          margin: 0;
          margin-bottom: 0.5rem;
          font-size: 1.8rem;
          font-weight: bold;
        }

        .description {
          // ちょっと薄い白
          color: rgba(commGateway.$color-text, 0.85);
        }
      }

      .links {
        padding: 0 0.2rem;
        padding-top: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;

        .website {
        }

        .socials {
          // 右寄せ
          margin-left: auto;
          display: flex;
          gap: 0.2rem;

          .social-youtube {
            :global(.icon-button:hover) {
              color: #ff0000;
            }
          }

          .social-twitch {
            :global(.icon-button:hover) {
              color: #9146ff;
            }
          }

          .social-x {
            :global(.icon-button:hover) {
              color: rgba(255, 255, 255, 0.7);
            }
          }

          .social-instagram {
            :global(.icon-button:hover) {
              color: #e1306c;
            }
          }

          .social-line {
            :global(.icon-button:hover) {
              color: #00c300;
            }
          }
        }
      }
    }
  }
</style>
