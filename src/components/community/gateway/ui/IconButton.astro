---
interface Props {
  /** hrefが指定された場合はroot要素として`a`が使用される */
  href?: string;
  target?: string;
  rel?: string;
}
const { href, target, rel } = Astro.props;
---

{
  href ? (
    <a {href} {target} {rel} class="icon-button">
      <slot />
    </a>
  ) : (
    <div class="icon-button" role="button" tabindex="0">
      <slot />
    </div>
  )
}

<style lang="scss">
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 50%;
    text-decoration: none;
    padding: 0.6rem;
    color: commGateway.$color-text;

    &:hover {
      background-color: rgba(commGateway.$color-text, 0.1);
    }
  }
</style>
