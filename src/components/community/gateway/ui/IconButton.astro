---
interface Props {
  /** hrefが指定された場合はroot要素として`a`が使用される */
  href?: string;
  target?: string;
  rel?: string;
  /** アイコンの代替テキスト（スクリーンリーダー向け） */
  ariaLabel: string;
}
const { href, target, rel, ariaLabel } = Astro.props;
---

{
  href ? (
    <a {href} {target} {rel} aria-label={ariaLabel} class="icon-button">
      <slot />
    </a>
  ) : (
    <button type="button" aria-label={ariaLabel} class="icon-button">
      <slot />
    </button>
  )
}

<style lang="scss">
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 50%;
    text-decoration: none;
    padding: 0.6rem;
    color: commGateway.$color-text;
    background: transparent;
    border: none;
    font: inherit;

    &:hover {
      background-color: rgba(commGateway.$color-text, 0.1);
    }
  }
</style>
