---
import { Image } from "astro:assets";
import type { WatchParty } from "@types";
import IconButton from "./IconButton.astro";

import TwitchIcon from "@components/icons/TwitchIcon.astro";
import TwitterXIcon from "@components/icons/TwitterXIcon.astro";
import InstagramIcon from "@components/icons/InstagramIcon.astro";
import LineIcon from "@components/icons/LineIcon.astro";

interface Props {
  watchParty: WatchParty;
}

const { watchParty } = Astro.props;
---

<div class="card">
  <div class="logo">
    {
      typeof watchParty.logoImage === "string" ? (
        <img src={watchParty.logoImage} alt={watchParty.name} />
      ) : (
        <Image src={watchParty.logoImage} alt={watchParty.name} />
      )
    }
  </div>
  <div class="body">
    <div class="info">
      <p class="name">{watchParty.name}</p>
      <p class="description">{watchParty.description}</p>
    </div>
    <div class="links">
      <div class="socials">
        {
          watchParty.socials.twitch && (
            <div class="social-twitch">
              <IconButton href={watchParty.socials.twitch} target="_blank">
                <TwitchIcon size={24} />
              </IconButton>
            </div>
          )
        }
        {
          watchParty.socials.twitter && (
            <div class="social-x">
              <IconButton href={watchParty.socials.twitter} target="_blank">
                <TwitterXIcon size={24} />
              </IconButton>
            </div>
          )
        }
        {
          watchParty.socials.instagram && (
            <div class="social-instagram">
              <IconButton href={watchParty.socials.instagram} target="_blank">
                <InstagramIcon size={24} />
              </IconButton>
            </div>
          )
        }
        {
          watchParty.socials.line && (
            <div class="social-line">
              <IconButton href={watchParty.socials.line} target="_blank">
                <LineIcon size={24} />
              </IconButton>
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  // 要素横幅670pxあたりが限界
  .card {
    width: 100%;
    max-width: 900px;
    display: flex;
    border: 2px solid rgba(commGateway.$color-text, 0.2);
    border-radius: 6px;

    @include sp {
      flex-direction: column;
    }

    .logo {
      width: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.6rem;
      border-right: 2px solid rgba(commGateway.$color-text, 0.2);

      img {
        max-width: 100%;
        max-height: 260px;
        object-fit: contain;
      }

      // 上側
      @include sp {
        width: auto;
        padding-inline: 4rem;
        border-right: none;
        border-bottom: 2px solid rgba(commGateway.$color-text, 0.2);
      }
    }

    .body {
      width: 50%;
      padding: 1.6rem;
      display: flex;
      flex-direction: column;

      @include sp {
        width: auto;
      }

      .info {
        flex-grow: 1;
        padding: 0 0.4rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(commGateway.$color-text, 0.2);

        .name {
          margin: 0;
          margin-bottom: 0.5rem;
          font-size: 1.8rem;
          font-weight: bold;
        }

        .description {
          // ちょっと薄い白
          color: rgba(commGateway.$color-text, 0.85);
        }
      }

      .links {
        padding: 0 0.2rem;
        padding-top: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;

        .website {
        }

        .socials {
          // 右寄せ
          margin-left: auto;
          display: flex;
          gap: 0.2rem;
        }
      }
    }
  }
</style>
