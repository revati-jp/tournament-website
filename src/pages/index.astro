---
import {
  getLatestTournament,
  getPathToTournament,
} from "../constants/tournaments";
import Layout from "../layouts/Layout.astro";

const latestTournament = getLatestTournament();
---

<Layout title="Home">
  <p>
    最新の大会: <a href={getPathToTournament(latestTournament)}
      >{latestTournament.label}</a
    >
  </p>
</Layout>
