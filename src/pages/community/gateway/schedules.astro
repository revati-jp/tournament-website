---
import { Image } from "astro:assets";
import GatewayLayout from "@layouts/community/GatewayLayout.astro";
import SectionTitle from "@components/community/gateway/ui/SectionTitle.astro";
import SectionBody from "@components/community/gateway/ui/SectionBody.astro";
import Button from "@components/community/gateway/ui/Button.astro";

import scheduleDay1 from "@assets/community/gateway/schedule_day1.webp";
import scheduleDay2 from "@assets/community/gateway/schedule_day2.webp";

const description =
  'REVATI Community Cup "Gateway" のタイムスケジュールを掲載しています。';
---

<GatewayLayout title="Schedules" meta={{ description }}>
  <SectionTitle primary="SCHEDULES" secondary="タイムスケジュール" />
  <SectionBody>
    <div class="schedule-container">
      <Image
        src={scheduleDay1}
        alt="DAY1 TIME SCHEDULE。日程は5/5（TUE）、形式はDOUBLE ELIMINATION。スケジュールは、13:10から15:10がGAME1–5（BRACKET TYPE: REGULAR MATCH）、15:30から16:45がGAME5–6（BRACKET TYPE: LOWER BRACKET）、17:00から18:15がGAME7–8（BRACKET TYPE: UPPER BRACKET）、18:15からENDINGとなっている。"
      />
      <Image
        src={scheduleDay2}
        alt="DAY2 TIME SCHEDULE。日程は5/6（WED）、形式はDOUBLE ELIMINATION。スケジュールは、13:10から14:20がGAME9–10（BRACKET TYPE: LOWER BRACKET）、14:40から15:10がGAME11（BRACKET TYPE: LOWER BRACKET）、15:20から15:50がGAME12（BRACKET TYPE: UPPER FINAL）、16:10から17:00がGAME13（BRACKET TYPE: LOWER FINAL / BO5）、17:10から18:00がGAME14（BRACKET TYPE: GRAND FINAL / BO5）、18:00からENDINGとなっている。"
      />
    </div>
  </SectionBody>

  <div class="back-button">
    <Button href="/community/gateway#schedules" variant="outlined" color="gray">
      TOPへ戻る
    </Button>
  </div>
</GatewayLayout>

<style lang="scss">
  .schedule-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));

    img {
      display: block;
      width: 100%;
      max-width: 550px;
      margin-inline: auto;
      height: auto;
    }
  }

  .back-button {
    display: flex;
    justify-content: flex-end;
    margin-top: 2rem;
  }
</style>
