---
import { Image } from "astro:assets";
import GatewayLayout from "@layouts/community/GatewayLayout.astro";
import SectionTitle from "@components/community/gateway/ui/SectionTitle.astro";
import SectionBody from "@components/community/gateway/ui/SectionBody.astro";
import Button from "@components/community/gateway/ui/Button.astro";

import regulationsQualifier from "@assets/community/gateway/regulations_qualifier.webp";
import regulationsMain from "@assets/community/gateway/regulations_main.webp";
import regulationsOthers from "@assets/community/gateway/regulations_others.webp";

const description =
  'REVATI Community Cup "Gateway" の大会ルールを掲載しています。';
---

<GatewayLayout title="Regulations" meta={{ description }}>
  <SectionTitle primary="REGULATIONS" secondary="大会ルール" />
  <SectionBody>
    <div class="title">予選規定</div>
    <Image
      src={regulationsQualifier}
      alt="REVATI COMMUNITY CUP GATEWAYの予選（QUALIFIER）レギュレーション。予選ルールは、全試合BO3、第一マップは運営指定でその後は敗者指定、ヒーローBAN無し。日程は、DAY1が5/2（SAT）でグループ別ラウンドロビンを行い上位2チームがDAY2進出（チーム数により変更の可能性あり）、DAY2が5/3（SUN）でシングルエリミネーショントーナメントを行い上位8チームが本戦進出（この時点の順位で本戦カードの組み合わせを決定）。"
    />

    <div class="title">本戦規定</div>
    <Image
      src={regulationsMain}
      alt="REVATI COMMUNITY CUP GATEWAYの本戦（MAIN STAGE）レギュレーション。本戦ルールは、準決勝及び決勝のみBO5、準決勝で4試合目以降はマッププールリセット、第一マップは運営指定でその後は敗者指定、ヒーローBANあり。日程は、DAY1が5/5（TUE）でダブルエリミネーショントーナメントのGAME8までを行い、DAY2が5/6（WED）でダブルエリミネーショントーナメントのGAME9から14までを行う。"
    />

    <div class="title">その他</div>
    <Image
      src={regulationsOthers}
      alt="REVATI COMMUNITY CUP GATEWAYのその他（OTHERS）レギュレーション。選手規定（ELIGIBILITY REGULATIONS）は、OWCS 2025 Stage3以前のOWCSメインステージへ出場経験があってはならない、満25歳以下であること、日本国籍を有している者のみが参加可能。ロスター規定（ROSTER REGULATIONS）は1チーム最大7名の選手を登録可能、マッププール（MAP POOL）はOWCSJAPAN 2026 STAGE1採用マップに準拠する。"
    />
  </SectionBody>

  <div class="back-button">
    <Button
      href="/community/gateway#regulations"
      variant="outlined"
      color="gray"
    >
      TOPへ戻る
    </Button>
  </div>
</GatewayLayout>

<style lang="scss">
  .title {
    font-size: 1.4rem;
    font-weight: bold;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    text-align: center;
  }

  img {
    display: block;
    width: 100%;
    margin-inline: auto;
    height: auto;
    border-radius: 10px;
  }

  .back-button {
    display: flex;
    justify-content: flex-end;
    margin-top: 2rem;
  }
</style>
