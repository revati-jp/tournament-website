---
import { Image } from "astro:assets";
import GatewayLayout from "@layouts/community/GatewayLayout.astro";
import SectionTitle from "@components/community/gateway/ui/SectionTitle.astro";
import SectionBody from "@components/community/gateway/ui/SectionBody.astro";
import Button from "@components/community/gateway/ui/Button.astro";
import TeamCard from "@components/community/gateway/ui/TeamCard.astro";
import BoxArrowUpRightIcon from "@components/icons/BoxArrowUpRightIcon.astro";
import { GATEWAY_SPONSORS } from "@constants/community/gateway/sponsors";
import { REVATI_TWITTER_URL, REVATI_YOUTUBE_URL } from "@utils/variables";

const description = 'REVATI Community Cup "Gateway" のトップページです。';

const sironekos = Array(6).fill("しろねこ");
---

<GatewayLayout title="TOP" meta={{ description }}>
  <div class="section-container">
    <section id="about">
      <SectionTitle primary="ABOUT" secondary="大会について" />
      <SectionBody>
        REVATI Community Cup "Gateway"
        は、Overwatchの競技シーンでの活躍を目指す若き才能を育てることを目的とする、REVATI主催のコミュニティ大会です。<br
        />
        Overwatchの競技コミュニティへの貢献・定期的な開催を目指しています。
      </SectionBody>
    </section>

    <section id="schedule">
      <SectionTitle primary="SCHEDULE" secondary="大会スケジュール" />
      <SectionBody>
        <div class="two-column-list schedule-list">
          <div class="two-column-row">
            <p class="two-column-label">
              [<span class="bold">予選</span> / 配信なし]
            </p>
            <p class="two-column-value">
              <time class="datetime" datetime="2026-05-02">2026.5.2</time>
              <span class="day">(Sat)</span> -
              <time class="datetime" datetime="2026-05-03">5.3</time>
              <span class="day">(Sun)</span>
            </p>
          </div>
          <div class="two-column-row">
            <p class="two-column-label">
              [<span class="bold">本戦</span> / 配信あり]
            </p>
            <p class="two-column-value">
              <time class="datetime" datetime="2026-05-05">2026.5.5</time>
              <span class="day">(Tue)</span> -
              <time class="datetime" datetime="2026-05-06">5.6</time>
              <span class="day">(Wed)</span>
              <time class="datetime time" datetime="2026-05-06T13:00:00"
                >13:00~</time
              >
            </p>
          </div>
        </div>
        <p class="note">
          ※予定時刻のため、変更になる可能性があります。変更の際は <a
            href={REVATI_TWITTER_URL}
            target="_blank"
            ><span class="bold">X</span>
            <BoxArrowUpRightIcon size={12} /></a
          > でお知らせいたします。
        </p>
      </SectionBody>
    </section>

    <section id="regulations">
      <SectionTitle primary="REGULATIONS" secondary="大会ルール" />
      <SectionBody>
        <div class="two-column-list regulations-list">
          <div class="two-column-row">
            <p class="two-column-label">[フォーマット]</p>
            <p class="two-column-value">
              (予選) <span class="bold">グループ別ラウンドロビン</span>
            </p>
          </div>
          <div class="two-column-row">
            <p
              class="two-column-label two-column-label--empty"
              aria-hidden="true"
            >
            </p>
            <p class="two-column-value">
              (本戦) <span class="bold">ダブルエリミネーション</span>
            </p>
          </div>
          <div class="two-column-row">
            <p class="two-column-label">[マッププール]</p>
            <p class="two-column-value">
              <span class="bold">OWCS 2026 Stage 1に準ずる</span>
            </p>
          </div>
          <div class="two-column-row">
            <p class="two-column-label">[大会配信]</p>
            <p class="two-column-value"><span class="bold">YouTube</span></p>
          </div>
        </div>
        <p>
          <Button
            variant="outlined"
            color="gray"
            href="/community/gateway/regulations">詳しいルールはこちら</Button
          >
          <Button href={REVATI_YOUTUBE_URL} target="_blank">
            REVATI YouTube <BoxArrowUpRightIcon />
          </Button>
        </p>
      </SectionBody>
    </section>

    <section id="teams">
      <SectionTitle primary="TEAMS" secondary="出場チーム" />
      <SectionBody>
        <p class="note">※本戦に出場するチームのみ掲載しています。</p>
        <div class="team-container">
          <TeamCard number={1} name="しろねこ" members={sironekos} />
          <TeamCard number={2} name="しろねこ" members={sironekos} />
          <TeamCard number={3} name="しろねこ" members={sironekos} />
          <TeamCard number={4} name="しろねこ" members={sironekos} />
        </div>
      </SectionBody>
    </section>

    <section id="sponsors">
      <SectionTitle primary="SPONSORS" secondary="スポンサー" />
      <SectionBody>
        <p>
          {
            GATEWAY_SPONSORS.map((sponsor) =>
              typeof sponsor.logoImage === "string" ? (
                <img src={sponsor.logoImage} alt={sponsor.name} height="50" />
              ) : (
                <Image src={sponsor.logoImage} alt={sponsor.name} height="50" />
              ),
            )
          }
        </p>
        <p><a href="/community/gateway/sponsors">スポンサーはこちら</a></p>
      </SectionBody>
    </section>
  </div>
</GatewayLayout>

<style lang="scss">
  .section-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .bold {
    font-weight: bold;
  }

  .note {
    font-size: 0.85rem;
    color: rgba(commGateway.$color-text, 0.9);
  }

  $schedule-collapse-breakpoint: 440px;
  $regulations-collapse-breakpoint: 380px;
  $schedule-collapsed-item-gap: 1rem;

  .two-column-list {
    display: grid;
    row-gap: 0;
  }

  .schedule-list {
    container: schedule-list / inline-size;
  }

  .regulations-list {
    container: regulations-list / inline-size;
  }

  .two-column-row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    align-items: start;
    column-gap: 0;
  }

  .two-column-label,
  .two-column-value {
    margin: 0;
  }

  .two-column-label {
    font-weight: normal;
  }

  .schedule-list {
    .two-column-value {
      @include commGateway.font-sofia-sans-extra-condensed-800;
      font-size: 1.6rem;

      .datetime {
        font-size: 2.1rem;
        letter-spacing: 0.04em;
      }

      .time {
        display: inline-block;
        margin-left: 0.8rem;
      }
    }
  }

  .regulations-list {
    .two-column-value {
      font-size: 1.1rem;
      letter-spacing: 0.04em;
    }

    .two-column-row + .two-column-row:not(:last-child) {
      padding-bottom: 0.8em;
    }
  }

  @container schedule-list (max-width: #{$schedule-collapse-breakpoint}) {
    .schedule-list .two-column-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.2rem;
    }

    .schedule-list .two-column-row + .two-column-row {
      margin-top: $schedule-collapsed-item-gap;
    }
  }

  @container regulations-list (max-width: #{$regulations-collapse-breakpoint}) {
    .regulations-list .two-column-row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.15rem;
    }

    .regulations-list .two-column-label--empty {
      display: none;
    }
  }

  $team-card-gap: 2rem;
  $team-single-column-breakpoint: 980px;

  .team-container {
    width: min(
      100%,
      calc(#{commGateway.$team-card-width} * 2 + #{$team-card-gap})
    );
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    justify-content: center;
    justify-items: center;
    gap: $team-card-gap;

    @media screen and (max-width: $team-single-column-breakpoint) {
      width: min(100%, commGateway.$team-card-width);
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
