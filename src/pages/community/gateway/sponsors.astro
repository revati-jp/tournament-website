---
import GatewayLayout from "../../../layouts/GatewayLayout.astro";
import SectionTitle from "../../../components/ui/SectionTitle.astro";
import SponsorCard from "../../../components/ui/SponsorCard.astro";
import { SPONSORS } from "../../../constants/sponsors";
---

<GatewayLayout title="Sponsors">
  <SectionTitle primary="SPONSORS" secondary="スポンサー" />

  <div class="sponsor-container">
    {SPONSORS.map((sponsor) => <SponsorCard sponsor={sponsor} />)}
  </div>
</GatewayLayout>

<style lang="scss">
  .sponsor-container {
    margin: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
