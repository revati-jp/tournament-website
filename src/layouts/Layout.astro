---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { COPYRIGHT, WEBSITE_TITLE, WEBSITE_URL } from '../utils';

interface Props {
  title: string;
}

const { title } = Astro.props;

// const absThumbnailPath = WEBSITE_URL + {header image src};
const fullTitle = `${WEBSITE_TITLE} | ${title}`;
const DESCRIPTION = "";
const canonicalUrl = WEBSITE_URL + Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
    <meta
      name="format-detection"
      content="telephone=no, address=no, email=no"
    />
    <!-- <meta name="thumbnail" content={absThumbnailPath} /> -->
    <!-- <meta
      name="google-site-verification"
      content=""
    /> -->

    <meta property="og:site_name" content={WEBSITE_TITLE} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:site" content={WEBSITE_URL} />
    <!-- ↓ Sass 変数 `$color-accent` -->
    <!-- <meta name="theme-color" content="" /> -->

    <meta name="keywords" content="revati,revati gateway" />
    <meta
      name="author"
      content="Rinrin.rs <rinrin0413.valley@gmail.com>, RetoRuto9900K <tutinoko2048@gmail.com>"
    />
    <meta name="copyright" content={COPYRIGHT} />

    <slot name="head" />

		<title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={DESCRIPTION} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- <meta property="og:image" content={absThumbnailPath} /> -->

    <link rel="canonical" href={canonicalUrl} />

    <Font cssVariable="--font-noto-sans-jp" />
    <Font cssVariable="--font-zalando-sans-expanded" />
    <Font cssVariable="--font-sofia-sans-extra-condensed" />

    <ClientRouter />
	</head>
	<body>
    <!-- Header -->

    <main transition:animate="fade">
      <slot />
    </main>

    <!-- Footer -->
	</body>
</html>

<style lang="scss">
  html {
    font-family: var(--font-noto-sans-jp), sans-serif;
  }

  body {
    background-color: $color-background;
    color: $color-text;
  }
</style>
