---
import { ClientRouter } from "astro:transitions";
import { WEBSITE_BASE_URL } from "@utils";

interface Props {
  title?: string;
  noindex?: boolean;
  disableCanonical?: boolean;
}

const { noindex = false, disableCanonical = false } = Astro.props;

const canonicalUrl = WEBSITE_BASE_URL + Astro.url.pathname;
---

<!--
  © 2026 REVATI | BSD 3-Clause "New" or "Revised" License
  リポジトリ: https://github.com/revati-jp/tournament-website
--><!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="format-detection"
      content="telephone=no, address=no, email=no"
    />
    <meta
      name="google-site-verification"
      content="Y2_5HsUC4aF517HYkAql5TlhdGr3d9yRpO3VKu9uBFw"
    />

    {!disableCanonical && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:site" content="@revati_jp" />
    <meta property="og:locale" content="ja_JP" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="keywords" content="revati" />
    <meta
      name="author"
      content="Rinrin.rs <rinrin0413.rs@gmail.com>, RetoRuto9900K <tutinoko2048@gmail.com>"
    />

    {!disableCanonical && <link rel="canonical" href={canonicalUrl} />}

    <slot name="head" />

    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<style lang="scss">
  html {
    height: 100%;
  }

  body {
    margin: 0;
  }
</style>
