---
import { ClientRouter } from "astro:transitions";
import { WEBSITE_BASE_URL } from "../utils";

const canonicalUrl = WEBSITE_BASE_URL + Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="format-detection"
      content="telephone=no, address=no, email=no"
    />
    <!-- <meta
      name="google-site-verification"
      content=""
    /> -->

    <meta name="keywords" content="revati" />
    <meta
      name="author"
      content="Rinrin.rs <rinrin0413.valley@gmail.com>, RetoRuto9900K <tutinoko2048@gmail.com>"
    />

    <meta property="og:url" content={canonicalUrl} />

    <link rel="canonical" href={canonicalUrl} />

    <slot name="head" />

    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<style lang="scss">
  body {
    margin: 0;
  }
</style>
