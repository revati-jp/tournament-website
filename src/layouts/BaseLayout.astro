---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { COPYRIGHT, WEBSITE_BASE_URL } from "../utils";

const canonicalUrl = WEBSITE_BASE_URL + Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="format-detection"
      content="telephone=no, address=no, email=no"
    />
    <!-- <meta
      name="google-site-verification"
      content=""
    /> -->

    <meta property="og:locale" content="ja_JP" />

    <meta name="keywords" content="revati" />
    <meta
      name="author"
      content="Rinrin.rs <rinrin0413.valley@gmail.com>, RetoRuto9900K <tutinoko2048@gmail.com>"
    />
    <meta name="copyright" content={COPYRIGHT} />

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="canonical" href={canonicalUrl} />

    <slot name="head" />

    <!-- //TODO - フォントを子レイアウト側で定義するかどうか検討 -->
    <Font cssVariable="--font-noto-sans-jp" />
    <Font cssVariable="--font-zalando-sans-expanded" />
    <Font cssVariable="--font-sofia-sans-extra-condensed" />

    <ClientRouter />
  </head>
  <body>
    <!-- //TODO - Header/Footerを子レイアウト側で定義するかどうか検討 -->
    <!-- Header -->

    <main transition:animate="fade">
      <slot />
    </main>

    <!-- Footer -->
  </body>
</html>

<style lang="scss">
  html {
    font-family: var(--font-noto-sans-jp), sans-serif;
  }

  body {
    background-color: $color-background;
    color: $color-text;
  }
</style>
