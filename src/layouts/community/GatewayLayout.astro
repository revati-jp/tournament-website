---
import BaseLayout from "../BaseLayout.astro";
import { WEBSITE_BASE_URL } from "../../utils";
import {
  getPathToTournament,
  getTournament,
} from "../../constants/tournaments";
import Header from "../../components/community/gateway/header/Header.astro";
import { Font } from "astro:assets";
import { COPYRIGHT } from "../../utils";

import keyVisual from "../../assets/community/gateway/kv_full.webp";

interface Props {
  title: string;
}

const { title } = Astro.props;

const tournament = getTournament("community", "gateway");

const websiteUrl = WEBSITE_BASE_URL + getPathToTournament(tournament);
const websiteTitle = tournament.label;
const fullTitle = `${websiteTitle} | ${title}`;

const absThumbnailPath = websiteUrl + keyVisual.src;
---

<BaseLayout>
  <Fragment slot="head">
    <meta name="thumbnail" content={absThumbnailPath} />

    <meta property="og:site_name" content={websiteTitle} />
    <!-- ↓ Sass 変数 `$color-primary` -->
    <meta name="theme-color" content="#e4ff00" />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={tournament.description} />
    <meta name="copyright" content={COPYRIGHT} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={tournament.description} />

    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={absThumbnailPath} />

    <Font cssVariable="--font-noto-sans-jp" />
    <Font cssVariable="--font-zalando-sans-expanded" />
    <Font cssVariable="--font-sofia-sans-extra-condensed" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/community/gateway/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/community/gateway/favicon-16x16.png"
    />

    <slot name="head" />
  </Fragment>

  <Header />

  <main transition:animate="fade">
    <slot />
  </main>

  <!-- Footer -->
</BaseLayout>

<style lang="scss">
  main {
    font-family: var(--font-noto-sans-jp), sans-serif;
    color: commGateway.$color-text;
    min-height: calc(100vh - commGateway.$header-height);
    // この背景色を body に指定すると、ヘッダーのバックドロップのぼかし効果が正常に動作しなくなる。
    background-color: commGateway.$color-background;
    padding-top: commGateway.$header-height;
  }
</style>
